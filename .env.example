# ==========================================================================
# 无车承运智能物流平台 - 环境变量模板
# ==========================================================================
# 使用方法：
#   1) 复制本文件为 .env，放在项目根目录（与 manage.py 同级）
#   2) 根据你的本地环境填充下列值
#   3) 不要把真实 .env 提交到 Git（已在 .gitignore 中排除）
# ==========================================================================

# --------------------------------------------------------------------------
# Django 基础配置
# --------------------------------------------------------------------------
# 生产环境请使用 python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 生成一个新的随机密钥
DJANGO_SECRET_KEY=changeme-please-generate-a-new-long-random-secret-key
DJANGO_DEBUG=True
# 多个域名用英文逗号分隔，例如：127.0.0.1,localhost,api.example.com
DJANGO_ALLOWED_HOSTS=*

# --------------------------------------------------------------------------
# MySQL 数据库
# --------------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=logistics_platform
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# --------------------------------------------------------------------------
# Redis（缓存 + Celery Broker）
# --------------------------------------------------------------------------
# 如果本地 Redis 未启用密码，留空即可
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Cache 用的 DB / Celery Broker 用的 DB（通常 0 和 1 分开即可）
REDIS_CACHE_DB=1
REDIS_CELERY_DB=0
REDIS_KEY_PREFIX=logistics
CACHE_TIMEOUT=300

# --------------------------------------------------------------------------
# JWT Token
# --------------------------------------------------------------------------
JWT_ACCESS_TTL_HOURS=24
JWT_REFRESH_TTL_DAYS=7

# --------------------------------------------------------------------------
# Celery （一般使用默认即可）
# --------------------------------------------------------------------------
# 如果你有独立的 Redis，可直接指定完整 URL（会覆盖上面拼接的方式）
# CELERY_BROKER_URL=redis://:password@host:port/0
CELERY_RESULT_BACKEND=django-db
